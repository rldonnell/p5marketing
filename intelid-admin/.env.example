# ─── Neon Postgres ─────────────────────────────────────────────────────────
# Get this from Vercel → Storage → your Neon database → .env.local tab.
# Add via `vercel link` + `vercel env pull` in production.
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# ─── Anthropic ─────────────────────────────────────────────────────────────
# For the competitor-suggestion endpoint.
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Auth ──────────────────────────────────────────────────────────────────
# Simple shared-secret auth for Phase 1. Anyone with this passphrase can log
# into the admin. Rotate when you bring on a teammate. Phase 2 graduates to
# GitHub OAuth.
ADMIN_PASSPHRASE="set-a-real-passphrase-here"

# 32+ random chars used to sign the session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_COOKIE_SECRET="set-a-real-secret-here"

# ─── Public app URL (used in client config defaults) ───────────────────────
NEXT_PUBLIC_APP_URL="https://admin.p5intel.com"
